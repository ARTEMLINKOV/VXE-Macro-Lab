<Window x:Class="VxeMacroLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VXE Macro Lab" Height="820" Width="1280"
        MinHeight="700" MinWidth="1000"
        Background="#0B0D12" Foreground="#F3F5FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141821"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D98AA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9ECF4"/>
            <Setter Property="Background" Value="#242B38"/>
            <Setter Property="BorderBrush" Value="#303949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30394A"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#59677E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7667F5"/><Setter Property="BorderBrush" Value="#7667F5"/><Setter Property="Foreground" Value="White"/></Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1A202B"/><Setter Property="BorderBrush" Value="#293242"/><Setter Property="Foreground" Value="#AEB8C8"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#AEB8C8"/><Setter Property="Background" Value="#171D27"/><Setter Property="Padding" Value="22,12"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#292447"/><Setter Property="Foreground" Value="#C6BFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#242B38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#10141C" BorderBrush="#202735" BorderThickness="0,0,1,0">
            <Grid Margin="20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="12" Background="#7667F5"><TextBlock Text="V" FontSize="21" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="VXE MACRO" FontSize="15" FontWeight="Bold" Foreground="#F5F6FB"/><TextBlock Text="LAB" FontSize="10" FontWeight="Bold" Foreground="#8B7CFF" Margin="0,1,0,0"/></StackPanel></StackPanel>
                <TextBlock Grid.Row="2" Text="MODULES" FontSize="10" FontWeight="Bold" Foreground="#667286" Margin="2,0,0,12"/>
                <StackPanel Grid.Row="3"><Border Background="#24213D" CornerRadius="9" Padding="12,11" Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="#A99FFF" FontSize="17" Width="26"/><TextBlock Text="Мышь" Foreground="#F1EFFF" FontSize="13" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#171D27" CornerRadius="9" Padding="12,11"><StackPanel Orientation="Horizontal"><TextBlock Text="⌨" Foreground="#AEB8C8" FontSize="15" Width="26"/><TextBlock Text="Клавиатура" Foreground="#AEB8C8" FontSize="13"/></StackPanel></Border></StackPanel>
                <Border Grid.Row="4" Background="#171D27" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="LOCAL MODE" FontSize="10" FontWeight="Bold" Foreground="#8B7CFF"/><TextBlock Text="Независимые модули" FontSize="12" Foreground="#D8DDE7" Margin="0,6,0,2"/><TextBlock Text="Windows desktop app" FontSize="10" Foreground="#758195"/></StackPanel></Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel><TextBlock Text="Рабочая область" FontSize="26" FontWeight="Bold" Foreground="#F4F6FB"/><TextBlock Text="Глобальный Snap-Tap работает во всех приложениях Windows." FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="GlobalSnapTapToggleButton" Content="Snap-Tap: ВКЛ" Click="GlobalSnapTapToggleButton_Click" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,10,0"/>
                    <Border Background="#171E29" BorderBrush="#2A3443" BorderThickness="1" CornerRadius="20" Padding="12,8"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#51D69A" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Готово" Foreground="#B9C4D4" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
                </StackPanel>
            </Grid>

            <TabControl x:Name="ModuleTabs" Grid.Row="1" SelectedIndex="0">
                <TabItem Header="⌁  Мышь"><Grid Margin="0,16,0,0"><TextBlock Text="МОДУЛЬ МЫШИ" Foreground="#AEB8C8"/></Grid></TabItem>
                <TabItem Header="⌨  Клавиатура"><Grid Margin="0,16,0,0"><TextBlock Text="МОДУЛЬ КЛАВИАТУРЫ" Foreground="#AEB8C8"/></Grid></TabItem>
                <TabItem Header="⇆  Snap-Tap (тест)"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,16"><StackPanel><TextBlock Text="SNAP-TAP LAB" FontSize="10" FontWeight="Bold" Foreground="#8B7CFF"/><TextBlock Text="Глобальный перехват WASD во всех приложениях" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Отпускание одной клавиши направления посылает краткий импульс противоположной клавиши." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border x:Name="SnapTapTestArea" Grid.Row="1" Background="#0D1118" BorderBrush="#4A426F" BorderThickness="1" CornerRadius="12" Padding="18" Focusable="True" PreviewKeyDown="SnapTapTestArea_PreviewKeyDown" PreviewKeyUp="SnapTapTestArea_PreviewKeyUp" LostKeyboardFocus="SnapTapTestArea_LostKeyboardFocus" MouseDown="SnapTapTestArea_MouseDown">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="SnapUpCard" Grid.Row="0" Grid.Column="1" Background="#191F2A" BorderBrush="#303949" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="W / ↑" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SnapUpState" Text="НЕ АКТИВНО" FontSize="11" FontWeight="Bold" Foreground="#8D98AA" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border x:Name="SnapLeftCard" Grid.Row="1" Grid.Column="0" Background="#191F2A" BorderBrush="#303949" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="A / ←" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SnapLeftState" Text="НЕ АКТИВНО" FontSize="11" FontWeight="Bold" Foreground="#8D98AA" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border x:Name="SnapDownCard" Grid.Row="2" Grid.Column="1" Background="#191F2A" BorderBrush="#303949" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="S / ↓" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SnapDownState" Text="НЕ АКТИВНО" FontSize="11" FontWeight="Bold" Foreground="#8D98AA" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border x:Name="SnapRightCard" Grid.Row="1" Grid.Column="2" Background="#191F2A" BorderBrush="#303949" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="D / →" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="SnapRightState" Text="НЕ АКТИВНО" FontSize="11" FontWeight="Bold" Foreground="#8D98AA" Margin="0,10,0,0"/></StackPanel></Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="SnapTapStatusText" Text="Фокус не активен · нажми на площадку" Foreground="#8D98AA" FontSize="12" VerticalAlignment="Center"/><Button Content="Сбросить" Click="SnapTapResetButton_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid>
                </Grid></TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="1,15,1,0"><TextBlock Text="GhostLayer · глобальный перехват клавиатуры" Foreground="#667286" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="WASD / A-D / W-S" Foreground="#667286" FontSize="11" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Grid>
</Window>
