<Window x:Class="VxeMacroLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VXE Macro Lab" Height="680" Width="980"
        MinHeight="560" MinWidth="780"
        Background="#FF15181D" Foreground="#FFE8EAED"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="VXE MACRO LAB" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Запись и анализ траектории мыши" Foreground="#FF9AA4B2" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Ожидание" 
                       VerticalAlignment="Center" Foreground="#FF9AA4B2" FontSize="13"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#FF20242B" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="RecordButton" Content="● Запись" Click="RecordButton_Click"
                        Padding="18,10" Margin="0,0,8,0" Background="#FFB84444" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold"/>
                <Button Content="Остановить" Click="StopButton_Click" Padding="16,10" Margin="0,0,8,0"/>
                <Button Content="Сохранить профиль" Click="SaveButton_Click" Padding="16,10" Margin="0,0,8,0"/>
                <Button Content="Открыть профиль" Click="LoadButton_Click" Padding="16,10" Margin="0,0,8,0"/>
                <Button Content="Очистить" Click="ClearButton_Click" Padding="16,10"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Предпросмотр траектории" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="EventCountText" DockPanel.Dock="Right" Text="0 событий"
                           Foreground="#FF9AA4B2"/>
            </DockPanel>
            <Border Grid.Row="1" Background="#FF20242B" CornerRadius="10" Padding="12">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True" Background="#FF1B1F25"/>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="F8 — начать / остановить запись" Foreground="#FF9AA4B2"/>
            <TextBlock DockPanel.Dock="Right" Text="Raw Input · JSON profiles" Foreground="#FF697586"/>
        </DockPanel>
    </Grid>
</Window>
