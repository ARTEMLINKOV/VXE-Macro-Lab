<Window x:Class="VxeMacroLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VXE Macro Lab" Height="780" Width="1240"
        MinHeight="680" MinWidth="980"
        Background="#0B0D12" Foreground="#F3F5FA"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141821"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1A202B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D98AA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9ECF4"/>
            <Setter Property="Background" Value="#242B38"/>
            <Setter Property="BorderBrush" Value="#303949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30394A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#59677E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7667F5"/>
            <Setter Property="BorderBrush" Value="#7667F5"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1A202B"/>
            <Setter Property="BorderBrush" Value="#293242"/>
            <Setter Property="Foreground" Value="#AEB8C8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#10141C" BorderBrush="#202735" BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="12" Background="#7667F5" VerticalAlignment="Center">
                        <TextBlock Text="V" FontSize="21" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VXE MACRO" FontSize="15" FontWeight="Bold" Foreground="#F5F6FB"/>
                        <TextBlock Text="LAB" FontSize="10" FontWeight="Bold" Foreground="#8B7CFF" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="WORKSPACE" FontSize="10" FontWeight="Bold"
                           Foreground="#667286" CharacterSpacing="140" Margin="2,0,0,12"/>

                <StackPanel Grid.Row="3">
                    <Border Background="#24213D" CornerRadius="9" Padding="12,11" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" Foreground="#A99FFF" FontSize="15" Width="25"/>
                            <TextBlock Text="Обзор" Foreground="#F1EFFF" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="Transparent" CornerRadius="9" Padding="12,11" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌁" Foreground="#8490A3" FontSize="16" Width="25"/>
                            <TextBlock Text="Редактор траектории" Foreground="#AEB7C6" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="Transparent" CornerRadius="9" Padding="12,11" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Foreground="#8490A3" FontSize="15" Width="25"/>
                            <TextBlock Text="Профили" Foreground="#AEB7C6" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="Transparent" CornerRadius="9" Padding="12,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="#8490A3" FontSize="15" Width="25"/>
                            <TextBlock Text="Настройки" Foreground="#AEB7C6" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="#171D27" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="LOCAL MODE" FontSize="10" FontWeight="Bold" Foreground="#8B7CFF"/>
                        <TextBlock Text="Работа без интеграций" FontSize="12" Foreground="#D8DDE7" Margin="0,6,0,2"/>
                        <TextBlock Text="Windows · Raw Input" FontSize="10" Foreground="#758195"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="30,25,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Рабочая область" FontSize="26" FontWeight="Bold" Foreground="#F4F6FB"/>
                    <TextBlock Text="Записывай движения мыши, сохраняй их и анализируй траектории."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#171E29"
                        BorderBrush="#2A3443" BorderThickness="1" CornerRadius="20" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#51D69A" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Готово" Foreground="#B9C4D4"
                                   FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#252D3A"
                    BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ЗАПИСЬ МЫШИ" FontSize="10" FontWeight="Bold"
                                   Foreground="#8B7CFF" CharacterSpacing="120"/>
                        <TextBlock Text="Управление захватом" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#F0F2F8" Margin="0,5,0,0"/>
                        <TextBlock Text="Запись физических перемещений через Windows Raw Input."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="RecordButton" Content="●  Начать запись" Click="RecordButton_Click"
                                Style="{StaticResource PrimaryButton}" Padding="19,12" Margin="0,0,8,0"/>
                        <Button Content="Остановить" Click="StopButton_Click" Padding="17,12" Margin="0,0,8,0"/>
                        <Button Content="Очистить" Click="ClearButton_Click" Style="{StaticResource QuietButton}"
                                Padding="17,12"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#252D3A"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="СОБЫТИЯ" FontSize="10" Foreground="#8490A3" FontWeight="Bold"/>
                        <TextBlock x:Name="EventCountText" Text="0 событий" FontSize="20"
                                   Foreground="#F1F3F8" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#252D3A"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ИСТОЧНИК" FontSize="10" Foreground="#8490A3" FontWeight="Bold"/>
                        <TextBlock Text="Windows Raw Input" FontSize="17"
                                   Foreground="#F1F3F8" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="#252D3A"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ФОРМАТ ПРОФИЛЯ" FontSize="10" Foreground="#8490A3" FontWeight="Bold"/>
                        <TextBlock Text="JSON" FontSize="20" Foreground="#F1F3F8"
                                   FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#252D3A"
                    BorderThickness="1" CornerRadius="15" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Предпросмотр траектории" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#F0F2F8"/>
                            <TextBlock Text="Визуализация записанного перемещения курсора"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Сохранить профиль" Click="SaveButton_Click"
                                    Style="{StaticResource QuietButton}" Margin="0,0,8,0" Padding="14,9"/>
                            <Button Content="Открыть профиль" Click="LoadButton_Click"
                                    Style="{StaticResource QuietButton}" Padding="14,9"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#0D1118" BorderBrush="#222B38"
                            BorderThickness="1" CornerRadius="10" Padding="8">
                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True" Background="#0D1118"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="1,16,1,0">
                <TextBlock Text="VXE Macro Lab  /  Desktop capture workspace"
                           Foreground="#667286" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="F8 · дополнительная горячая клавиша записи"
                           Foreground="#667286" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
